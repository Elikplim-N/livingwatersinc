{
  "rewrites": [
    {
      "source": "/overview",
      "destination": "/overview.html"
    },
    {
      "source": "/collect",
      "destination": "/collect.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
