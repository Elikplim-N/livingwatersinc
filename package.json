{
  "name": "lwi-street-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@vercel/node": "^27.0.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.14.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "dev": "vercel dev",
    "db:setup": "node scripts/db-setup.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 --strict api/index.ts",
    "build:css": "tailwindcss -c tailwind.config.cjs -i styles/tailwind.css -o app.css --minify",
    "db:reset": "node scripts/reset-db.mjs"
  }
}
