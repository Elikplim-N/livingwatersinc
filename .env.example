# Copy to .env (local) and set the same values in Vercel → Project → Settings → Environment Variables.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Long random string used to sign login tokens (required in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Mapbox GL JS public token (starts with pk.); can also be pasted in Admin → Map style
MAPBOX_TOKEN=
# Optional Mapbox Studio style, e.g. mapbox://styles/yourname/styleid
MAPBOX_STYLE=
